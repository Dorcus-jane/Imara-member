rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verifiedEmail() {
      return signedIn()
        && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function linkedMember(memberId, memberNo) {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.memberId == memberId
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.memberNo == memberNo;
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /users/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.auth.uid == uid
        && verifiedEmail()
        && request.resource.data.keys().hasAll(['memberId', 'memberNo', 'name', 'email', 'phone', 'createdAt'])
        && request.resource.data.keys().hasOnly(['memberId', 'memberNo', 'name', 'email', 'phone', 'createdAt'])
        && request.resource.data.email == request.auth.token.email
        && exists(/databases/$(database)/documents/members/$(request.resource.data.memberId))
        && get(/databases/$(database)/documents/members/$(request.resource.data.memberId)).data.email == request.auth.token.email
        && get(/databases/$(database)/documents/members/$(request.resource.data.memberId)).data.memberNo == request.resource.data.memberNo;
      allow update, delete: if false;
    }

    match /members/{memberId} {
      allow read: if isAdmin()
        || (verifiedEmail() && resource.data.email == request.auth.token.email);
      allow write: if isAdmin();
    }

    match /deposits/{depositId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin()
        || (signedIn()
          && linkedMember(request.resource.data.memberId, request.resource.data.memberNo)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.method in ['Mobile Money', 'Till']
          && request.resource.data.keys().hasAll(['userId', 'memberId', 'memberName', 'memberNo', 'amount', 'method', 'reference', 'phone', 'receivedAt', 'createdAt', 'createdBy', 'status'])
          && request.resource.data.keys().hasOnly(['userId', 'memberId', 'memberName', 'memberNo', 'amount', 'method', 'reference', 'phone', 'receivedAt', 'createdAt', 'createdBy', 'status']));
      allow update, delete: if isAdmin();
    }

    match /loans/{loanId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin()
        || (signedIn()
          && linkedMember(request.resource.data.memberId, request.resource.data.memberNo)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.termMonths is int
          && request.resource.data.termMonths > 0
          && request.resource.data.termMonths <= 60
          && request.resource.data.annualRate is number
          && request.resource.data.annualRate >= 0
          && request.resource.data.annualRate <= 100
          && get(/databases/$(database)/documents/members/$(request.resource.data.memberId)).data.loanLimit is number
          && request.resource.data.amount <= get(/databases/$(database)/documents/members/$(request.resource.data.memberId)).data.loanLimit
          && request.resource.data.keys().hasAll(['userId', 'memberId', 'memberName', 'memberNo', 'amount', 'annualRate', 'termMonths', 'purpose', 'guarantorName', 'guarantorPhone', 'status', 'createdAt', 'createdBy'])
          && request.resource.data.keys().hasOnly(['userId', 'memberId', 'memberName', 'memberNo', 'amount', 'annualRate', 'termMonths', 'purpose', 'guarantorName', 'guarantorPhone', 'status', 'createdAt', 'createdBy']));
      allow update, delete: if isAdmin();
    }

    match /repayments/{repaymentId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }
  }
}
